[Unit]
Description=EVOXU job administration and public careers API
After=network.target

[Service]
Type=simple
User=evoxuind
Group=evoxuind
WorkingDirectory=/var/www/evoxuind/current/backend
EnvironmentFile=/etc/evoxuind/jobs.env
ExecStart=/opt/evoxuind/venv/bin/gunicorn --workers 2 --bind 127.0.0.1:8067 --timeout 30 --access-logfile - --error-logfile - app:app
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/evoxuind

[Install]
WantedBy=multi-user.target
